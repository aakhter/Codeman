{
  "id": "codeman-assistant",
  "name": "Codeman Assistant",
  "description": "Explicit private Telegram requests to a named Codeman assistant. Requires the durable request engine.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["baseUrl", "assistantId", "accountId", "allowFrom", "tokenEnv"],
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "assistantId": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "allowFrom": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "tokenEnv": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "mediaRoot": {
        "type": "string",
        "description": "Absolute Telegram inbound download directory; attachment forwarding requires a same-host Codeman connection."
      }
    }
  },
  "activation": {
    "onStartup": true
  }
}
